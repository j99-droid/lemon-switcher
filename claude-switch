#!/usr/bin/env python3
"""claude-switch: swap which Claude Code account this machine (and OpenClaw) uses.

OpenClaw runs Claude through the `claude` CLI (agentRuntime "claude-cli"), so it
always uses whatever account Claude Code is logged into. Switching the Claude
Code login and restarting the OpenClaw gateway switches both.

Usage:
  claude-switch                 interactive menu
  claude-switch list            show saved accounts (* = active)
  claude-switch add NAME        log a new person in and save them as NAME
  claude-switch save NAME       save whoever is logged in right now as NAME
  claude-switch use NAME        switch to NAME
  claude-switch remove NAME     forget a saved account
  claude-switch restart         restart OpenClaw on the current account
  claude-switch usage           show each account's 5-hour usage left
  claude-switch auto [on|off]   show or set auto-switching when a limit is reached
  claude-switch auto check      auto-switch now if the active account is out
"""
import contextlib
import fcntl
import json
import os
import shutil
import subprocess
import sys
import time
import urllib.request
from datetime import datetime
from pathlib import Path

HOME = Path.home()
CLAUDE_DIR = Path(os.environ.get("CLAUDE_CONFIG_DIR", HOME / ".claude"))
CREDS = CLAUDE_DIR / ".credentials.json"
GLOBAL_JSON = HOME / ".claude.json"
STORE = HOME / ".claude-accounts"
ACTIVE = STORE / "active"
AUTO_FILE = STORE / "autoswitch"
LOCK = STORE / "switch.lock"
AUTO_OUT = 2        # the active lemon counts as out below this % left
AUTO_MIN_LEFT = 10  # only switch to a lemon with at least this % left
GATEWAY_UNIT = "openclaw-gateway.service"
USAGE_URL = "https://api.anthropic.com/api/oauth/usage"

# Apps started from the desktop menu don't get ~/.local/bin on PATH, which is
# where the claude installer puts `claude`.
_local_bin = str(HOME / ".local" / "bin")
if _local_bin not in os.environ.get("PATH", "").split(os.pathsep):
    os.environ["PATH"] = _local_bin + os.pathsep + os.environ.get("PATH", "")


class SwitchError(Exception):
    pass


def die(msg):
    raise SwitchError(msg)


def read_json(path):
    try:
        return json.loads(path.read_text())
    except FileNotFoundError:
        return None


def write_json(path, data):
    # Write to a temp file and rename, so a crash never leaves half a file.
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".switch-tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(data, f, indent=2)
    os.replace(tmp, path)


def valid_name(name):
    if not name or not name.replace("-", "").replace("_", "").isalnum():
        die("names can only use letters, numbers, - and _")
    return name.lower()


def profiles():
    if not STORE.exists():
        return []
    return sorted(p.name for p in STORE.iterdir() if (p / "credentials.json").exists())


def active():
    try:
        return ACTIVE.read_text().strip() or None
    except FileNotFoundError:
        return None


def set_active(name):
    STORE.mkdir(mode=0o700, exist_ok=True)
    ACTIVE.write_text(name or "")


def email_of(name):
    acct = read_json(STORE / name / "account.json") or {}
    return acct.get("emailAddress", "?")


def fetch_usage(token):
    req = urllib.request.Request(USAGE_URL, headers={
        "Authorization": f"Bearer {token}",
        "anthropic-beta": "oauth-2025-04-20",
        "User-Agent": "lemon-switcher",
    })
    with urllib.request.urlopen(req, timeout=10) as r:
        five = json.load(r).get("five_hour") or {}
    resets = five.get("resets_at")
    return {
        "used": float(five.get("utilization") or 0),
        "resets_at": datetime.fromisoformat(resets.replace("Z", "+00:00")).timestamp() if resets else None,
        "checked": time.time(),
    }


def usage_of(name):
    """5-hour usage for NAME: {used %, resets_at, checked, stale} or None if unknown.

    Uses the saved token as-is and never refreshes it (refreshing would rotate
    the login). When the token has expired or the check fails, falls back to
    the last reading, which counts as fully reset once its window has passed.
    """
    cache_file = STORE / name / "usage.json"
    src = CREDS if name == active() else STORE / name / "credentials.json"
    oauth = (read_json(src) or {}).get("claudeAiOauth") or {}
    token, expires = oauth.get("accessToken"), (oauth.get("expiresAt") or 0) / 1000
    if token and expires > time.time() + 60:
        try:
            u = fetch_usage(token)
            write_json(cache_file, u)
            return {**u, "stale": False}
        except Exception:  # noqa: BLE001 - offline etc.; fall back to the cache
            pass
    u = read_json(cache_file)
    if not u:
        return None
    if u.get("resets_at") and u["resets_at"] < time.time():
        u = {**u, "used": 0.0, "resets_at": None}
    return {**u, "stale": True}


def auto_enabled():
    try:
        return AUTO_FILE.read_text().strip() == "on"
    except FileNotFoundError:
        return False


def set_auto(on):
    STORE.mkdir(mode=0o700, exist_ok=True)
    AUTO_FILE.write_text("on" if on else "off")


def auto_pick(usages):
    """Which lemon to switch to, given {name: usage_of(name)}, or None.

    Only switches when the active lemon's fresh reading says it's out, and only
    to the lemon with the most left, if that's at least AUTO_MIN_LEFT.
    """
    cur = active()
    u = usages.get(cur)
    if not cur or not u or u["stale"] or 100 - u["used"] >= AUTO_OUT:
        return None
    left = [(100 - v["used"], n) for n, v in usages.items() if n != cur and v]
    best = max(left, default=None)
    return best[1] if best and best[0] >= AUTO_MIN_LEFT else None


@contextlib.contextmanager
def switch_lock(wait=True):
    """Only one switch at a time, across the window, the timer and the terminal.

    Yields False instead of waiting when wait=False and someone else holds it.
    """
    STORE.mkdir(mode=0o700, exist_ok=True)
    with open(LOCK, "w") as f:
        try:
            fcntl.flock(f, fcntl.LOCK_EX | (0 if wait else fcntl.LOCK_NB))
        except BlockingIOError:
            yield False
            return
        yield True


def notify(text):
    if shutil.which("notify-send"):
        subprocess.run(["notify-send", "-i", "system-users", "Lemon Switcher", text],
                       capture_output=True)


def auto_switch(usages):
    """Switch away from the active lemon if it's out. Returns (old, new) or None.

    Picks again under the lock, so if the window and the timer both notice at
    once, the second one sees the new active lemon and leaves it alone.
    """
    with switch_lock(wait=False) as got:
        if not got:
            return None
        old, pick = active(), auto_pick(usages)
        if not pick:
            return None
        print(f"'{old}' has reached its limit.")
        _use(pick)
    notify(f"{old} reached its 5-hour limit, so we switched to {pick}.")
    return old, pick


def save_current(name):
    """Copy the live login into profile NAME."""
    creds = read_json(CREDS)
    if not creds or "claudeAiOauth" not in creds:
        die("nobody is logged into Claude Code right now")
    acct = (read_json(GLOBAL_JSON) or {}).get("oauthAccount", {})
    STORE.mkdir(mode=0o700, exist_ok=True)
    (STORE / name).mkdir(mode=0o700, exist_ok=True)
    write_json(STORE / name / "credentials.json", creds)
    write_json(STORE / name / "account.json", acct)
    return acct.get("emailAddress", "?")


def sync_active():
    """Claude refreshes tokens as it runs, so save the live copy back first."""
    cur = active()
    if cur and cur in profiles() and read_json(CREDS):
        save_current(cur)


def load_profile(name):
    creds = read_json(STORE / name / "credentials.json")
    acct = read_json(STORE / name / "account.json") or {}
    write_json(CREDS, creds)
    g = read_json(GLOBAL_JSON) or {}
    if acct:
        g["oauthAccount"] = acct
    else:
        g.pop("oauthAccount", None)
    write_json(GLOBAL_JSON, g)


def clear_login():
    if CREDS.exists():
        CREDS.unlink()
    g = read_json(GLOBAL_JSON)
    if g and "oauthAccount" in g:
        g.pop("oauthAccount")
        write_json(GLOBAL_JSON, g)


def restart_gateway():
    if os.environ.get("CLAUDE_SWITCH_NO_RESTART"):
        return
    if shutil.which("systemctl") is None:
        return
    found = subprocess.run(
        ["systemctl", "--user", "cat", GATEWAY_UNIT],
        capture_output=True,
    ).returncode == 0
    if not found:
        return
    print("Restarting OpenClaw so it picks up the new account...")
    r = subprocess.run(["systemctl", "--user", "restart", GATEWAY_UNIT])
    if r.returncode != 0:
        print(f"warning: could not restart {GATEWAY_UNIT}; restart OpenClaw yourself")


def gateway_stale():
    """True if OpenClaw started before the current login was written."""
    r = subprocess.run(
        ["systemctl", "--user", "show", GATEWAY_UNIT, "-p", "ActiveEnterTimestampMonotonic", "--value"],
        capture_output=True, text=True,
    )
    started_us = int(r.stdout.strip() or 0) if r.returncode == 0 else 0
    if not started_us or not CREDS.exists():
        return False
    # Compare against the monotonic clock: how long ago each thing happened.
    started_ago = time.monotonic() - started_us / 1e6
    login_ago = time.time() - CREDS.stat().st_mtime
    return login_ago < started_ago


def cmd_usage():
    for n in profiles():
        u = usage_of(n)
        if not u:
            print(f"   {n:<12} unknown")
            continue
        left = max(0, 100 - u["used"])
        bar = "#" * round(left / 5)
        when = f", resets {time.strftime('%H:%M', time.localtime(u['resets_at']))}" if u.get("resets_at") else ""
        note = " (last known)" if u["stale"] else ""
        print(f"   {n:<12} [{bar:<20}] {left:3.0f}% left{when}{note}")


def cmd_auto(arg=None):
    if arg in ("on", "off"):
        set_auto(arg == "on")
    elif arg == "check":
        if not auto_enabled():
            print("Auto-switch is off.")
            return
        if not auto_switch({n: usage_of(n) for n in profiles()}):
            print("No switch needed.")
        return
    elif arg is not None:
        die("use: claude-switch auto [on|off|check]")
    print(f"Auto-switch is {'on' if auto_enabled() else 'off'}.")


def cmd_list():
    cur = active()
    names = profiles()
    if not names:
        print("No saved accounts yet. Open Lemon Switcher, or run:  claude-switch save lemon1")
        return
    for n in names:
        mark = "*" if n == cur else " "
        print(f" {mark} {n:<12} {email_of(n)}")


def cmd_save(name):
    name = valid_name(name)
    email = save_current(name)
    set_active(name)
    print(f"Saved the current login ({email}) as '{name}'.")
    if shutil.which("systemctl") and gateway_stale():
        restart_gateway()


def cmd_restart():
    restart_gateway()


def cmd_use(name):
    with switch_lock():
        _use(name)


def _use(name):
    name = valid_name(name)
    if name not in profiles():
        die(f"no saved account '{name}' (see: claude-switch list)")
    if name == active():
        print(f"'{name}' is already active.")
        return
    sync_active()
    load_profile(name)
    set_active(name)
    print(f"Switched to '{name}' ({email_of(name)}).")
    restart_gateway()
    print("Close and reopen any open Claude Code windows so they use the new account.")


def cmd_add(name):
    name = valid_name(name)
    if name in profiles():
        die(f"'{name}' already exists; use 'claude-switch use {name}'")
    if shutil.which("claude") is None:
        die("the 'claude' command isn't installed or isn't on PATH")
    sync_active()
    previous = active()
    clear_login()
    set_active(None)
    print(f"\nClaude Code will open now. {name}: type /login, sign in with")
    print("YOUR account in the browser, then type /exit to come back here.\n")
    input("Press Enter to continue...")
    subprocess.run(["claude"])
    if not read_json(CREDS):
        print("No login happened.")
        if previous:
            load_profile(previous)
            set_active(previous)
            print(f"Put '{previous}' back.")
        return
    email = save_current(name)
    set_active(name)
    print(f"Saved {email} as '{name}' and switched to it.")
    restart_gateway()


def cmd_remove(name):
    name = valid_name(name)
    if name not in profiles():
        die(f"no saved account '{name}'")
    if name == active():
        die("that account is active; switch to someone else first")
    shutil.rmtree(STORE / name)
    print(f"Removed '{name}'.")


def menu():
    while True:
        names = profiles()
        cur = active()
        print("\n=== Claude account switcher ===")
        print(f"Active: {cur or '(none saved)'}\n")
        for i, n in enumerate(names, 1):
            mark = " <- active" if n == cur else ""
            print(f"  {i}. {n}  ({email_of(n)}){mark}")
        print("\n  a. add a person   s. save current login   r. remove   q. quit")
        choice = input("> ").strip().lower()
        if choice == "q" or choice == "":
            return
        try:
            menu_action(choice, names)
        except SwitchError as e:
            print(f"error: {e}")


def menu_action(choice, names):
    if choice.isdigit() and 1 <= int(choice) <= len(names):
        cmd_use(names[int(choice) - 1])
    elif choice == "a":
        cmd_add(input("Name for the new person: ").strip())
    elif choice == "s":
        cmd_save(input("Save current login as: ").strip())
    elif choice == "r":
        cmd_remove(input("Name to remove: ").strip())
    else:
        print("?")


def main():
    args = sys.argv[1:]
    if not args:
        return menu()
    cmd, rest = args[0], args[1:]
    one_arg = {"save": cmd_save, "use": cmd_use, "add": cmd_add, "remove": cmd_remove}
    if cmd == "list":
        cmd_list()
    elif cmd == "restart":
        cmd_restart()
    elif cmd == "usage":
        cmd_usage()
    elif cmd == "auto" and len(rest) <= 1:
        cmd_auto(*rest)
    elif cmd in one_arg and len(rest) == 1:
        one_arg[cmd](rest[0])
    else:
        print(__doc__)
        sys.exit(1)


if __name__ == "__main__":
    try:
        main()
    except SwitchError as e:
        print(f"error: {e}", file=sys.stderr)
        sys.exit(1)
    except (KeyboardInterrupt, EOFError):
        print()
